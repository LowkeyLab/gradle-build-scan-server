load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//angular/bzl:ng.bzl", "ng_application", "ng_test", "process_styles")

exports_files([
    "tsconfig.app.json",
    "tsconfig.spec.json",
])

copy_to_bin(
    name = "srcs",
    srcs = glob(
        ["src/**/*"],
        exclude = [
            "src/**/*.spec.ts",
            "src/styles.css",
            "dist/**",
        ],
    ),
)

copy_to_bin(
    name = "srcs_test",
    srcs = glob(
        ["src/**/*"],
        exclude = [
            "src/styles.css",
            "dist/**",
        ],
    ),
)

process_styles(
    name = "processed_styles",
    src = "src/styles.css",
    srcs = glob(["src/**/*.ts"]),
    out = "src/processed_styles.css",
    deps = [
        "//angular:node_modules/daisyui",
    ],
)

