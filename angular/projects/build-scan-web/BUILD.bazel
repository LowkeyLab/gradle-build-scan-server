load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//angular/bzl:ng.bzl", "ng_application", "ng_test", "process_styles")

exports_files([
    "tsconfig.app.json",
    "tsconfig.spec.json",
])

copy_to_bin(
    name = "srcs",
    srcs = glob(
        ["src/**/*"],
        exclude = [
            "src/**/*.spec.ts",
            "src/styles.css",
            "dist/**",
        ],
    ),
)

copy_to_bin(
    name = "srcs_test",
    srcs = glob(
        ["src/**/*"],
        exclude = [
            "src/styles.css",
            "dist/**",
        ],
    ),
)

process_styles(
    name = "processed_styles",
    src = "src/styles.css",
    srcs = glob(["src/**/*.ts"]),
    out = "src/processed_styles.css",
    deps = [
        "//angular:node_modules/daisyui",
    ],
)

# Transitive deps of @observablehq/plot -> d3 -> d3-* sub-packages,
# d3-dag -> d3-array/javascript-lp-solver/quadprog/stringify-object,
# and interval-tree-1d -> binary-search-bounds.
# Bazel sandboxing requires these to be explicitly listed.
_PLOT_TRANSITIVE_DEPS = [
    "//angular:node_modules/@observablehq/plot",
    "//angular:node_modules/binary-search-bounds",
    "//angular:node_modules/delaunator",
    "//angular:node_modules/internmap",
    "//angular:node_modules/robust-predicates",
    "//angular:node_modules/d3",
    "//angular:node_modules/d3-array",
    "//angular:node_modules/d3-axis",
    "//angular:node_modules/d3-brush",
    "//angular:node_modules/d3-chord",
    "//angular:node_modules/d3-color",
    "//angular:node_modules/d3-contour",
    "//angular:node_modules/d3-dag",
    "//angular:node_modules/d3-delaunay",
    "//angular:node_modules/d3-dispatch",
    "//angular:node_modules/d3-drag",
    "//angular:node_modules/d3-dsv",
    "//angular:node_modules/d3-ease",
    "//angular:node_modules/d3-fetch",
    "//angular:node_modules/d3-force",
    "//angular:node_modules/d3-format",
    "//angular:node_modules/d3-geo",
    "//angular:node_modules/d3-hierarchy",
    "//angular:node_modules/d3-interpolate",
    "//angular:node_modules/d3-path",
    "//angular:node_modules/d3-polygon",
    "//angular:node_modules/d3-quadtree",
    "//angular:node_modules/d3-random",
    "//angular:node_modules/d3-scale",
    "//angular:node_modules/d3-scale-chromatic",
    "//angular:node_modules/d3-selection",
    "//angular:node_modules/d3-shape",
    "//angular:node_modules/d3-time",
    "//angular:node_modules/d3-time-format",
    "//angular:node_modules/d3-timer",
    "//angular:node_modules/d3-transition",
    "//angular:node_modules/d3-zoom",
    "//angular:node_modules/interval-tree-1d",
    "//angular:node_modules/isoformat",
    "//angular:node_modules/javascript-lp-solver",
    "//angular:node_modules/quadprog",
    "//angular:node_modules/stringify-object",
]

ng_application(
    name = "build-scan-web",
    srcs = [
        ":processed_styles",
        ":srcs",
    ],
    tailwindcss = True,
    visibility = ["//build-scan/server/src:__pkg__"],
    deps = [
        "//angular:node_modules/@angular/forms",
        "//angular:node_modules/@angular/router",
        "//angular:node_modules/@apollo/client",
        "//angular:node_modules/@wry/caches",
        "//angular:node_modules/@wry/context",
        "//angular:node_modules/@wry/equality",
        "//angular:node_modules/@wry/trie",
        "//angular:node_modules/apollo-angular",
        "//angular:node_modules/graphql",
        "//angular:node_modules/graphql-tag",
        "//angular:node_modules/optimism",
    ] + _PLOT_TRANSITIVE_DEPS,
)

ng_test(
    name = "test",
    srcs = [
        ":processed_styles",
        ":srcs_test",
    ],
    tailwindcss = True,
    vitest = True,
    deps = [
        "//angular:node_modules/@angular/forms",
        "//angular:node_modules/@angular/router",
        "//angular:node_modules/@apollo/client",
        "//angular:node_modules/@wry/caches",
        "//angular:node_modules/@wry/context",
        "//angular:node_modules/@wry/equality",
        "//angular:node_modules/@wry/trie",
        "//angular:node_modules/apollo-angular",
        "//angular:node_modules/graphql",
        "//angular:node_modules/graphql-tag",
        "//angular:node_modules/optimism",
    ] + _PLOT_TRANSITIVE_DEPS,
)
