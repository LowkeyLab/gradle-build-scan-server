ng_application(
    name = "build-scan-web",
    srcs = [
        ":processed_styles",
        ":srcs",
    ],
    tailwindcss = True,
    visibility = ["//build-scan/server/src:__pkg__"],
    deps = [
        "//angular:node_modules/@angular/forms",
        "//angular:node_modules/@angular/router",
        "//angular:node_modules/@apollo/client",
