---
import "../styles/global.css";

type Frontmatter = {
  title: string;
  description?: string;
};

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
const pageTitle = `${frontmatter.title} · Gradle Build Scan Server`;
const pageDescription =
  frontmatter.description ??
  "Project documentation for Gradle Build Scan Server.";
const homeHref = import.meta.env.BASE_URL;
const bazelHref = `${import.meta.env.BASE_URL}bazel/`;
const onBazelPage = Astro.url.pathname.endsWith("/bazel/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
  </head>
  <body>
    <div class="site-shell">
      <header class="panel site-header">
        <div class="site-header-copy">
          <p class="eyebrow">Documentation</p>
          <a class="site-title" href={homeHref}>Gradle Build Scan Server</a>
          <p class="site-summary">
            A self-hosted server for receiving and viewing Gradle build scans.
          </p>
        </div>

        <nav class="site-nav" aria-label="Primary">
          <a
            class={onBazelPage ? "nav-link" : "nav-link nav-link-active"}
            href={homeHref}
            aria-current={onBazelPage ? undefined : "page"}
          >
            Overview
          </a>
          <a
            class={onBazelPage ? "nav-link nav-link-active" : "nav-link"}
            href={bazelHref}
            aria-current={onBazelPage ? "page" : undefined}
          >
            Bazel workflows
          </a>
        </nav>
      </header>

      <main class="panel doc-panel">
        <article class="doc-content">
          <slot />
        </article>
      </main>
    </div>
  </body>
</html>
