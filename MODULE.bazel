# Currently bazel-lib is only load()ed when platforms is used.
bazel_dep(name = "bazel_lib", version = "3.2.2")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")  # force a recent version that works with v3
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "apple_support", version = "2.5.2")
bazel_dep(name = "aspect_rules_lint", version = "2.3.0")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_multitool", version = "1.11.1")
bazel_dep(name = "bazel_env.bzl", version = "0.7.2")
bazel_dep(name = "bazelrc-preset.bzl", version = "1.8.0")

# We have to take a dependency on rules_python in order to set bootstrap=script
# for transitive dependencies, even if there are no Python rules used in this repo.
# See .bazelrc
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "gazelle", version = "0.48.0")

# Dev dependencies
bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.9.0", dev_dependency = True)
bazel_dep(name = "gazelle_rust", dev_dependency = True)
git_override(
    module_name = "gazelle_rust",
    commit = "62dace6f23b648f662d716723ab8eee2aab4b556",
    remote = "https://github.com/Calsign/gazelle_rust.git",
)

# JavaScript / Angular
bazel_dep(name = "aspect_rules_js", version = "3.0.3")
bazel_dep(name = "rules_angular")
git_override(
    module_name = "rules_angular",
    commit = "32ce54318d9ec5d84269d4acecbc39944cd8b5e7",
    remote = "https://github.com/devversion/rules_angular.git",
)

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//tools:tools.lock.json")
use_repo(multitool, "multitool")

#########################
# Support for Rust, see https://github.com/bazelbuild/rules_rust
bazel_dep(name = "rules_rust", version = "0.69.0")
bazel_dep(name = "rules_rs", version = "0.0.29")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.93.1"],
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")

#########################
# JavaScript and pnpm package manager

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(pnpm_version = "latest")
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

register_toolchains("//tools/toolchains:all")

##########################
# Container images
oci_extension = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci_extension.pull(
    name = "distroless_cc",
    digest = "sha256:56aaf20ab2523a346a67c8e8f8e8dabe447447d0788b82284d14ad79cd5f93cc",
    image = "gcr.io/distroless/cc-debian13",
    platforms = [
        "linux/amd64",
    ],
)
use_repo(oci_extension, "distroless_cc", "distroless_cc_linux_amd64")
