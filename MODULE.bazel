# Currently bazel-lib is only load()ed when platforms is used.
bazel_dep(name = "bazel_lib", version = "3.5.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")  # force a recent version that works with v3
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "apple_support", version = "2.7.0")
bazel_dep(name = "aspect_rules_lint", version = "2.5.2")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_java", version = "9.6.1")
bazel_dep(name = "rules_kotlin", version = "2.4.0")
bazel_dep(name = "rules_jvm_external", version = "7.0")
bazel_dep(name = "rules_go", version = "0.61.1")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "bazelrc-preset.bzl", version = "1.9.2")

# We have to take a dependency on rules_python in order to set bootstrap=script
# for transitive dependencies, even if there are no Python rules used in this repo.
# See .bazelrc
bazel_dep(name = "rules_python", version = "1.9.1")
bazel_dep(name = "gazelle", version = "0.51.3")

# Dev dependencies
bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.9.0", dev_dependency = True)
bazel_dep(name = "gazelle_rust", dev_dependency = True)
git_override(
    module_name = "gazelle_rust",
    commit = "c26dc35e8aa2a4ad08fe87ed098285c83ca71b98",
    remote = "https://github.com/Calsign/gazelle_rust.git",
)

# JavaScript / Angular
bazel_dep(name = "aspect_rules_js", version = "3.2.2")
bazel_dep(name = "rules_angular")
git_override(
    module_name = "rules_angular",
    commit = "50b8a6daa50cfbbab422d5f29f85c40128e10fd1",
    remote = "https://github.com/devversion/rules_angular.git",
)

rules_angular_ext = use_extension("@rules_angular//setup:extensions.bzl", "rules_angular")
rules_angular_ext.setup(
    angular_compiler_cli = "//:node_modules/@angular/compiler-cli",
    typescript = "//:node_modules/typescript",
)
use_repo(rules_angular_ext, "rules_angular_configurable_deps")

#########################
# Go SDK for Gazelle plugins

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.5")

#########################
# Support for Rust, see https://github.com/bazelbuild/rules_rust
# rules_rs v0.0.56+ bundles its own internal rules_rust; provision @rules_rust
# from it so BUILD files and crate toolchain types share the same module.
bazel_dep(name = "rules_rs", version = "0.0.59")
bazel_dep(name = "llvm", version = "0.8.11")

rules_rust = use_extension("@rules_rs//rs/experimental:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

toolchains = use_extension(
    "@rules_rs//rs/experimental/toolchains:module_extension.bzl",
    "toolchains",
)
toolchains.toolchain(
    edition = "2024",
    version = "1.93.1",
)
use_repo(toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//:all")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
    use_experimental_platforms = True,
)
use_repo(crate, "crates")

#########################
# JavaScript and pnpm package manager

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(pnpm_version = "latest")
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

#########################
# Java and Kotlin

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "ch.qos.logback:logback-classic:1.5.38",
        "com.gradle:develocity-gradle-plugin:4.5.0",
        "io.arrow-kt:arrow-core:2.2.3",
        "io.arrow-kt:arrow-fx-coroutines:2.2.3",
        "io.arrow-kt:arrow-optics:2.2.3",
        "io.arrow-kt:arrow-resilience:2.2.3",
        "io.ktor:ktor-server-core-jvm:3.5.1",
        "io.ktor:ktor-server-netty-jvm:3.5.1",
        "org.ow2.asm:asm:9.10.1",
    ],
    fetch_javadoc = True,
    fetch_sources = True,
    known_contributing_modules = ["protobuf"],
    lock_file = "//:maven_install.json",
    repositories = [
        "https://repo1.maven.org/maven2/",
        "https://plugins.gradle.org/m2/",
    ],
)
maven.artifact(
    testonly = True,
    artifact = "kotlin-test",
    group = "org.jetbrains.kotlin",
    version = "2.4.0",
)
maven.artifact(
    testonly = True,
    artifact = "kotlin-test-junit5",
    group = "org.jetbrains.kotlin",
    version = "2.4.0",
)
maven.artifact(
    testonly = True,
    artifact = "junit-jupiter-api",
    group = "org.junit.jupiter",
    version = "6.1.2",
)
maven.artifact(
    testonly = True,
    artifact = "junit-jupiter-engine",
    group = "org.junit.jupiter",
    version = "6.1.2",
)
maven.artifact(
    testonly = True,
    artifact = "junit-jupiter-params",
    group = "org.junit.jupiter",
    version = "6.1.2",
)
maven.artifact(
    testonly = True,
    artifact = "junit-platform-console",
    group = "org.junit.platform",
    version = "6.1.2",
)
maven.artifact(
    testonly = True,
    artifact = "ktor-server-test-host-jvm",
    group = "io.ktor",
    version = "3.5.1",
)
use_repo(maven, "maven")

register_toolchains("//:kotlin_toolchain")

register_toolchains("//tools/toolchains:all")

